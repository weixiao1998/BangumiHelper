# 启动引导配置（改后需 docker compose up -d 重建容器生效）
# 运行时可变配置（蜜柑URL/账号/代理/注册模式等）请在管理后台「系统设置」页面修改

# 应用密钥（生产环境必须修改），用于 JWT 令牌签名，建议使用随机生成的强密码
SECRET_KEY=your-super-secret-key-change-in-production

# 数据库配置（程序按 DB_TYPE 自动拼接 DATABASE_URL 与对应驱动，无需手写连接串）
# 切换数据库：DB_TYPE 改为 postgresql + 更换 compose 的 db 服务 + 更换 Python 驱动依赖
DB_TYPE=mysql
DB_HOST=db
# DB_PORT 留空则按 DB_TYPE 取默认端口（mysql 3306 / postgresql 5432），一般无需修改
# DB_PORT=3306
DB_USER=bangumi
DB_PASSWORD=bangumi
DB_NAME=bangumi
# 仅 compose 中 db 服务初始化用（应用不直接使用）
DB_ROOT_PASSWORD=rootpass

# 番剧日历刷新间隔（小时）
CALENDAR_REFRESH_INTERVAL=1
